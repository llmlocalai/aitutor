
# --- Contract triage (Blueprint 0.5, 2.1) ---
# snapshot: read src/contract_triage/data/*.parquet, no keys needed
# databricks: read gold views through DATABRICKS_WAREHOUSE_ID (set on the app)
DATA_BACKEND=snapshot
# SAM.gov public API key (sam.gov > profile > details). Never commit it.
SAM_API_KEY=
# api.data.gov key for the Data.gov Catalog API v4
DATAGOV_API_KEY=
