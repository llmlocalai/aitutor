# ~/.contract-triage.env  (Blueprint stage 0). One place for the names every step uses.
# Not a secret file: API keys live in the repo's .env (git-ignored) and in a Databricks
# secret scope. Load it in every new terminal:   source ~/.contract-triage.env
export GH_USER="<your GitHub user name>"
export REPO_NAME="contract-triage-mcp"
export REPO="$HOME/code/$REPO_NAME"
export AITUTOR="$HOME/code/aitutor"                        # this guide's repository
export KIT="$AITUTOR/native/contract-triage/overlay"        # the files the steps copy
export DATABRICKS_HOST="https://dbc-aae0ba16-8727.cloud.databricks.com"
export PROFILE="<profile name you chose at databricks auth login>"
export DBX_USER="<your workspace user name, usually your email>"
export CATALOG="<catalog GSA or Databricks named in office hours>"
export WAREHOUSE_ID="<SQL warehouse id you may use>"
export APP_NAME="mcp-server-contract-triage"                # must start with mcp-
export SANDBOX_APP="mcp-server-pshang-sandbox"
export GIT_FOLDER="/Workspace/Users/$DBX_USER/$REPO_NAME"
export OFFICES="<two or three pilot office codes, comma separated>"
