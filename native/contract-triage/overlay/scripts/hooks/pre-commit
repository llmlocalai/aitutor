#!/usr/bin/env bash
# Refuse a commit whose staged changes contain the value of a key in .env, or a .env file.
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail
if git diff --cached --name-only | grep -E '(^|/)\.env$' >/dev/null; then
  echo "pre-commit: a .env file is staged. Unstage it: git restore --staged <file>" >&2; exit 1
fi
[[ -f .env ]] || exit 0
while IFS='=' read -r name value; do
  [[ "$name" =~ _KEY$|_TOKEN$|_SECRET$ ]] || continue
  value="${value%\"}"; value="${value#\"}"
  [[ ${#value} -ge 8 ]] || continue
  if git diff --cached -U0 | grep -F -- "$value" >/dev/null; then
    echo "pre-commit: the value of $name is in the staged changes. Remove it." >&2; exit 1
  fi
done < <(grep -E '^[A-Z_]+=' .env)
