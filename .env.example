# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Local build (tried first). Issue a dedicated key with chat scope only and no tools.
LOCAL_AGENT_URL=
LOCAL_AGENT_KEY=
LOCAL_MODEL=
LOCAL_TIMEOUT=40

# Cloud fallback: any OpenAI-compatible endpoint.
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# Limits. Add Upstash for limits that hold across function instances.
TUTOR_RATE_PER_MIN=6
TUTOR_DAILY_CAP=400
TUTOR_MAX_TOKENS=700
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
