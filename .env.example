# Set these in Vercel: Project > Settings > Environment Variables (Production and Preview).
# Same names as datamatter. Never commit real values.

# Local links, tried in order. Point at agent-server through the funnel. /v1 is added if missing.
LOCAL_LLM_FUNNEL_URL=https://<your-funnel-host>:<port>
LOCAL_LLM_API_KEY=          # a key issued for this site: keys_admin.py create aitutor --scope chat
LOCAL_LLM_MODEL_PRIMARY=qwen3.8:27b-q8_0
LOCAL_LLM_MODEL_SECONDARY=qwen3.6:35b-a3b
LOCAL_LLM_TIMEOUT_MS=170000  # capped by the 110 s budget; 25 s are kept back for the cloud link

# Cloud link, used only when both local links fail. Any OpenAI-compatible endpoint.
CLOUD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_LLM_MODEL=gemini-3.5-flash-lite
CLOUD_LLM_API_KEY=

# Limits. Add Upstash for limits that hold across function instances.
TUTOR_RATE_PER_MIN=6
TUTOR_DAILY_CAP=400
TUTOR_MAX_TOKENS=700
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
